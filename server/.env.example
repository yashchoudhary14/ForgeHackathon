DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adhikaar
# For Neon paste the Console URL, including ?sslmode=require&channel_binding=require.
# auto uses verified WSS (443) for Neon; Cloud Run sets tcp for native TLS (5432).
DATABASE_TRANSPORT=auto

GEMINI_API_KEY=
# aistudio (uses GEMINI_API_KEY) or vertex (bills the google cloud project, uses a service account)
GEMINI_BACKEND=aistudio
GCP_PROJECT=
GCP_LOCATION=global
# vertex auth, pick one: an api key bound to a service account, or a credentials json (path or raw json).
# both empty = gcloud application-default login locally / the attached service account on cloud run
VERTEX_API_KEY=
GCP_CREDENTIALS=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MODEL_POOL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Per-model sliding-window requests/minute, shared across callers in ONE API worker.
# Defaults: AI Studio 12 RPM; paid Vertex 600 RPM. Uncomment to override.
# GEMINI_RPM=12
# Optional JSON overrides, e.g. {"gemini-3.5-flash-lite":15}
GEMINI_MODEL_RPM={}
GEMINI_QUEUE_TIMEOUT=45
GEMINI_CALL_TIMEOUT=25
GEMINI_PROBE_TIMEOUT=10
LLM_CACHE_TTL_HOURS=24
GEMINI_EMBED_MODEL=gemini-embedding-001

SARVAM_API_KEY=

# used to encrypt citizen profile fields at rest (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PROFILE_SECRET=

CLIENT_ORIGIN=http://localhost:5173
# Comma-separated exact origins, e.g. https://adhikaar.vercel.app,http://localhost:5173
AGENT_HEADLESS=true
AGENT_ALLOWED_DOMAINS=gov.in,nic.in
# Docker/Cloud Run use ephemeral /tmp/adhikaar; local uvicorn uses this path.
STORAGE_DIR=storage
